{
  // Markdownlint config for authored documentation. Rules are tuned to
  // match existing conventions:
  //   - YAML frontmatter supplies the page title; bodies still open with an
  //     `# H1` so the raw .md renders on GitHub. We tell MD025 to ignore the
  //     frontmatter title so the in-body H1 is the only "top-level" heading.
  //   - Lists use `-`, code fences carry a language tag
  //   - Inline HTML is allowed for explicit anchors and generated content
  //   - Long prose lines are intentional; no hard wrap is enforced
  //   - TypeDoc-generated pages legitimately repeat "Parameters"/"Returns"
  //     and the endpoint reference uses a `**Field**` pattern as in-row
  //     labels, so MD024/MD036/MD060 are disabled
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": false,
    "MD025": { "front_matter_title": "" },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": true,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD060": false,
    "relative-links": false,
  },
  "customRules": ["markdownlint-rule-relative-links"],
  "overrides": [
    {
      "filter": ["docs/reference/**", "docs/appendix/endpoint-reference.md"],
      "combine": "replace",
      "config": { "default": false, "MD051": true, "relative-links": true },
    },
    {
      "filter": ["docs/**"],
      "combine": "merge",
      "config": { "relative-links": true },
    },
  ],
  "globs": ["docs/**/*.md"],
  "ignores": ["**/node_modules/**", "docs/test-fests/**", "CHANGELOG.md"],
}
